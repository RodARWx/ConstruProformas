# ==============================================================================
# CONSTRUPROFORMAS — VARIABLES DE ENTORNO PRINCIPALES (DOCKER / PRODUCCIÓN)
# Copie este archivo como .env en la raíz para orquestación con docker-compose.
# ==============================================================================

# Puertos expuestos en el servidor host
PORT=3000
FRONTEND_PORT=8080

# Seguridad y Autenticación
APP_PIN=123456
JWT_SECRET=construproformas-produccion-secreto-cambiar
JWT_EXPIRES_IN_SECONDS=28800

# Base de datos persistente en el contenedor
DATABASE_PATH=/app/data/construproformas.db
DB_SYNCHRONIZE=true

# Almacenamiento estructurado de proformas en el NAS
PROFORMAS_STORAGE_PATH=/mnt/proformas

# Control de numeración correlativa
PROFORMA_ID_OFFSET=200

# Orígenes CORS permitidos
CORS_ORIGIN=*

# QR de validación institucional
PROFORMA_VALIDATION_BASE_URL=https://construmetrica.com/validar-proforma
