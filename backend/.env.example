# ==============================================================================
# CONSTRUPROFORMAS BACKEND — VARIABLES DE ENTORNO
# Copie este archivo como .env en el directorio backend/ y configure sus valores.
# ==============================================================================

# Puerto HTTP en el que escucha el servicio NestJS
PORT=3000

# Ruta al archivo SQLite
# Desarrollo local (desde backend/): ../data/construproformas.db
# Docker / OpenMediaVault: /app/data/construproformas.db
DATABASE_PATH=../data/construproformas.db

# Sincronización automática de esquema TypeORM al iniciar.
# Mantener en true hasta contar con migraciones automáticas.
DB_SYNCHRONIZE=true

# Orígenes frontend permitidos por CORS (separados por coma si son varios).
# Desarrollo local: http://localhost:5173,http://localhost:5174
# Producción: http://192.168.1.100:8080 (o dominio asignado en red local/OMV)
# Dejar vacío o '*' para permitir cualquier origen.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ------------------------------------------------------------------------------
# SEGURIDAD Y AUTENTICACIÓN (Fase 3 & Fase 5)
# ------------------------------------------------------------------------------

# PIN institucional de acceso a la aplicación.
# El frontend lo envía a POST /api/auth/login para obtener el token Bearer JWT.
# ADVERTENCIA: Cambie este valor por un PIN seguro antes de desplegar en producción.
APP_PIN=123456

# Clave secreta para firmar los tokens JWT emitidos por la aplicación.
# En producción, genere un secreto criptográficamente seguro ejecutando:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=construproformas-dev-secret-cambiame

# Tiempo de vida del token JWT en segundos.
# 28800 segundos = 8 horas (duración estándar de una jornada laboral).
JWT_EXPIRES_IN_SECONDS=28800

# ------------------------------------------------------------------------------
# ALMACENAMIENTO Y CONTROL DE VERSIONES NAS (Fase 2)
# ------------------------------------------------------------------------------

# Ruta absoluta al almacenamiento estructurado de proformas (OMV / NAS).
# Si se define, las carpetas 'PROFORMAS {AÑO}/{ID} {PROYECTO}/' se crearán aquí.
# Si se deja vacío o comentado, se usará la carpeta local: {directorio_db}/proformas/
# Ejemplo en Docker montando el share del NAS:
# PROFORMAS_STORAGE_PATH=/mnt/proformas

# ------------------------------------------------------------------------------
# CONTROL DE NUMERACIÓN CORRELATIVA (Fase 1)
# ------------------------------------------------------------------------------

# Número de inicio correlativo al arrancar por primera vez en el año en curso.
# Si la base de datos ya contiene proformas con número mayor, el sistema toma el máximo + 1.
# Ejemplo: si el archivo físico en papel/NAS llegó a 159, fijar en 200 deja margen seguro.
PROFORMA_ID_OFFSET=200

# ------------------------------------------------------------------------------
# EXPORTACIÓN INSTITUCIONAL Y FORMATO DE DOCUMENTOS
# ------------------------------------------------------------------------------

# URL base para el código QR de verificación que se inserta en los PDF
PROFORMA_VALIDATION_BASE_URL=https://construmetrica.com/validar-proforma

# Ruta personalizada de logo (opcional; por defecto backend/assets/images/logo-construmetrica.png)
# PROFORMA_LOGO_PATH=/ruta/absoluta/logo.png

# Fuentes Gotham opcionales (por defecto backend/assets/fonts/)
# PROFORMA_FONT_GOTHAM_BLACK_PATH=
# PROFORMA_FONT_GOTHAM_BOOK_PATH=

# Ruta al ejecutable de Puppeteer / Chromium en entornos Docker/Linux (opcional)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser